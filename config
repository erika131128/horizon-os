#!/bin/sh
set -e
lb config noauto \
  --distribution trixie \
  --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --debian-installer none \
  --binary-images iso-hybrid \
  --linux-flavours amd64 \
  --security true --updates true \
  --iso-application "Horizon OS" \
  --iso-publisher "Horizon OS Project" \
  --iso-volume "HORIZON_OS" \
  --image-name horizon-os \
  --bootappend-live "boot=live components quiet splash username=horizon locales=pt_BR.UTF-8 keyboard-layouts=br timezone=America/Sao_Paulo" \
  "${@}"
